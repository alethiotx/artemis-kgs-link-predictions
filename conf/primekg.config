params {
    dataset = 'primekg'
    model = 's3://alethiotx-artemis/data/kgs-no-data-leakage/embeddings/' + params.dataset + '/' + params.embedding + '/trained_model.pkl'
    training_triples = 's3://alethiotx-artemis/data/kgs-no-data-leakage/embeddings/' + params.dataset + '/' + params.embedding + '/training_triples'
}

process {
    withLabel:process_single {
        cpus   = { 2 }
        memory = { 48.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
}